#!name=G1 ACQ Trial
#!desc=v7.5.0-trial：与原版 G1 ACQ v7.5.0 完全相同，仅改一处映射：g1.ios.20tb.m.v2 -> g1.ai.ultra.1month_eft.acq（Ultra 免费试用 1 个月）；其余采集、报告、2TB/30TB 逻辑与原版一致
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/duwqijlk/g1-ultra-trial@main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/duwqijlk/g1-ultra-trial@main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
